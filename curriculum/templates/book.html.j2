{#- The start of a lesson in the levels after Starter: what kind of lesson,
    its title, and what the student will be able to do. #}
{%- macro lesson_start(l) %}
    <div class="lstart" data-lesson="{{ l.lesson }}" data-title="{{ l.title }}" data-toc="lesson-{{ l.lesson }}" data-unit="{{ l.unit }}">
      <div class="hero">
        <div class="tile icon k-{{ l.kind }}"><svg viewBox="0 0 24 24">{{ icons[l.icon]|safe }}</svg></div>
        <div>
          <span class="kind k-{{ l.kind }}">{{ kind_label[l.kind] }} · Lesson {{ l.lesson }}</span>
          <h1>{{ l.title }}</h1>
          <p>{{ l.subtitle }}</p>
          <div class="goal">{% for g in l.goals %}<span>{{ g }}</span>{% endfor %}</div>
        </div>
      </div>
      {%- if l.timeline %}
      <div class="day" aria-hidden="true">
        {%- for s in l.timeline %}
        <div><i><svg viewBox="0 0 24 24">{{ icons[s.icon]|safe }}</svg></i><b>{{ s.time }}</b><small>{{ s.label }}</small></div>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
{%- endmacro %}
{%- macro qa(l, num) %}
    <div class="sec qa" data-lesson="{{ l.lesson }}">
      <h2><span class="num">{{ num }}</span>Questions and answers <small>Answer fast. Short answers are fine.</small></h2>
      {%- for q, a in l.questions %}
      <div class="q"><span class="n">{{ loop.index }}</span><div><b>{{ q }}</b><span>{{ a }}</span></div></div>
      {%- endfor %}
    </div>
{%- endmacro %}
{#- Idioms, proverbs and phrases, from the levels with idioms: true. Each
    one is marked in the lesson where it is used. #}
{%- macro idioms_box(l, num) %}
    {%- if l.idioms %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">{{ num }}</span>Idioms, proverbs and phrases</h2>
      <div class="idioms n{{ l.idioms|length }}">
        {%- for e in l.idioms %}
        <div class="idm {{ e.type }}"><span class="it">{{ e.type }}</span><b>{{ e.expr }}</b><p>{{ e.meaning }}</p><i>{{ e.example }}</i></div>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
{%- endmacro %}
{%- macro new_words(l, num) %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">{{ num }}</span>New words</h2>
      <div class="words">
        {%- for w in l.words %}
        <div class="word"><b>{{ w.word }}</b>{{ w.meaning }}</div>
        {%- endfor %}
      </div>
    </div>
{%- endmacro %}
{%- if book %}
{%- set c = level.course %}
{%- set parts = level.name.rsplit(' ', 1) %}
{%- set numbered = parts|length == 2 and parts[1].isdigit() %}
{% if level.name == 'Starter' %}
<div class="page cover starter-cover">
  <img class="starter-cover-art" src="starter-cover-art.png" alt="">
  <img class="starter-cover-logo" src="starter-cover-logo.png" alt="Future Vision Institute logo">
</div>
{% else %}
<div class="page cover">
  {#- Every level of the course, the first at the bottom; this book's level is filled. #}
  <div class="cv-strip" aria-hidden="true">
    {%- for st in c.stages|reverse %}
    {%- set si = loop.revindex0 %}
    {%- for name in st.levels|reverse %}<i class="s{{ si }}{{ ' now' if name == level.name }}"></i>{% endfor %}
    {%- endfor %}
  </div>
  <div class="cv-brand">
    <img src="{{ assets }}/logo-512.png" alt="">
    <div><b>Future Vision</b><span>{{ c.institute_line }}</span></div>
  </div>
  <div class="cv-box">
    <div class="cv-top">
      <div>
        <span class="lbl">Level</span>
        {%- if numbered %}
        <div class="cv-num">{{ parts[1] }}</div>
        {%- else %}
        {#- Levels without a number (Starter) show the star from the logo. #}
        <svg class="cv-num cv-star" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 6l12.6 30.6 33 2.6-25.2 21.5 7.8 32.2L50 75.6 21.8 92.9l7.8-32.2L4.4 39.2l33-2.6z"/></svg>
        {%- endif %}
      </div>
      {%- if level.cefr %}
      {%- set cf = level.cefr.split('-', 1) if level.cefr.startswith('Pre-') else ['', level.cefr] %}
      <div class="cefr">{% if cf[0] %}<small class="pre">{{ cf[0] }}</small>{% endif %}<b>{{ cf[1] }}</b><small>CEFR</small></div>
      {%- endif %}
    </div>
    {%- set title = parts[0] if numbered else level.name %}
    <h1 class="cv-name{{ ' long' if title|length > 10 }}">{{ title }}</h1>
    <span class="bar"></span>
    <p class="cv-tag">{{ level.tagline }}</p>
  </div>
  <div class="cv-course"><b>{{ c.course }}</b><span>Student Book</span></div>
  <div class="cv-fields">
    {%- for f in ['Student Name', 'Teacher', 'Group / Time', 'Month'] %}
    <div><b>{{ f }}</b><i></i></div>
    {%- endfor %}
  </div>
  <div class="cv-foot"><i></i><span{{ ' class="long"'|safe if level.subtitle|length > 32 }}>{{ level.subtitle }}</span><i></i></div>
</div>
{% endif %}
<div class="page toc">
  {{ head('Contents') }}
  <h1 class="toc-title">Contents</h1>
  {%- for part, entries in contents %}
  <div class="toc-part">
    <h2>{{ part }}</h2>
    {%- for ref, n, title, kind in entries %}
    <div class="toc-row"><span class="toc-n">{{ n }}</span><span class="toc-t">{{ title }}{% if kind %}<small class="kind k-{{ kind|lower }}">{{ kind }}</small>{% endif %}</span><span class="toc-dots"></span><span class="toc-p" data-toc-ref="{{ ref }}"></span></div>
    {%- endfor %}
  </div>
  {%- endfor %}
  <div class="foot"><span><b>{{ level.name }}</b> · Contents</span><span>Future Vision Institute</span><span class="pg"></span></div>
</div>
{%- endif %}
{%- for p in pages %}{% set l = p.lesson %}
{%- if l.kind == 'story' %}
{%- set c = level.cast[l.pov.speaker] %}
<div class="page stream" data-title="{{ l.title }}" data-part="Unit {{ l.unit }}" data-tighten>
  {{ head('Unit ' ~ l.unit ~ ' · Lesson ' ~ l.lesson) }}
  <div class="flow">
    {{ lesson_start(l) }}
    {%- if level.split_boxes %}
    {#- Paragraphs sit directly in the section, joined into one box, so a long
        story can continue on the next page. #}
    <div class="sec reading" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>The story</h2>
      {%- for para in l.story %}
      <p class="para">{{ para|mark }}</p>
      {%- endfor %}
    </div>
    {%- else %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>The story</h2>
      <div class="story">{% for para in l.story %}<p>{{ para|mark }}</p>{% endfor %}</div>
    </div>
    {%- endif %}
    {{ qa(l, 2) }}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">3</span>Point of view <small>{{ l.pov.intro }}</small></h2>
      <div class="story pov">
        <span class="av {{ c.color }}">{{ c.initial }}</span>
        <div>{% for para in l.pov.text %}<p>{{ para|mark }}</p>{% endfor %}</div>
      </div>
    </div>
    {#- From levels with split_boxes, the box comes in two parts that join
        into one: when a page runs out, the second part (notes and question)
        continues on the next page. Earlier levels keep their single box. #}
    {%- set cols = l.learn.table[0]|length %}
    {%- set wide = cols > 2 or l.learn.wide %}
    {%- set split = level.split_boxes %}
    {%- set notes %}
          <div class="notes">
            {%- for n in l.learn.notes %}
            <div><b>{{ n.title|mark('em') }}</b>{{ n.text }}</div>
            {%- endfor %}
          </div>
    {%- endset %}
    {%- set ask %}
        <div class="ask"><b>Questions</b><span>{{ l.learn.ask[0] }}</span><i>{{ l.learn.ask[1] }}</i></div>
    {%- endset %}
    <div class="sec{{ ' lsec' if split }}" data-lesson="{{ l.lesson }}">
      <h2><span class="num">4</span>What did you learn?</h2>
      <div class="learn">
        <h3>{{ l.learn.title|mark('em') }}</h3>
        <p>{{ l.learn.intro }}</p>
        <div class="learn-body{{ ' wide' if wide }}">
          <div class="forms c{{ cols }}">
            {%- for row in l.learn.table %}
            <div>{% for cell in row %}<span>{{ cell|mark('em') }}</span>{% endfor %}</div>
            {%- endfor %}
          </div>
          {%- if not (split and wide) %}{{ notes }}{% endif %}
        </div>
        {%- if not split %}{{ ask }}{% endif %}
      </div>
      {%- if split %}
      <div class="learn more">
        {%- if wide %}{{ notes }}{% endif %}
        {{- ask }}
      </div>
      {%- endif %}
    </div>
    {{- idioms_box(l, 5) }}
    {{ new_words(l, 6 if l.idioms else 5) }}
  </div>
  {{ foot(l.title, 'Unit ' ~ l.unit) }}
</div>
{%- elif l.kind == 'news' %}
<div class="page stream" data-title="{{ l.title }}" data-part="Unit {{ l.unit }}" data-tighten>
  {{ head('Unit ' ~ l.unit ~ ' · Lesson ' ~ l.lesson) }}
  <div class="flow">
    {{ lesson_start(l) }}
    {#- A newspaper page: its parts join into one box, and the article may
        continue on the next page between paragraphs. #}
    <div class="sec reading news" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>Read the article</h2>
      <div class="paper"><b>{{ l.paper }}</b><span>{{ l.date }}</span></div>
      <h3 class="headline">{{ l.headline }}</h3>
      <p class="stand">{{ l.standfirst }}</p>
      <p class="byline">{{ l.byline }}</p>
      {%- for para in l.text %}
      <p class="para">{{ para|mark('k') }}</p>
      {%- if l.quote and loop.index == l.quote.after %}
      <p class="para quote">“{{ l.quote.text }}”<span>{{ l.quote.by }}</span></p>
      {%- endif %}
      {%- endfor %}
    </div>
    {%- set ns = namespace(n=1) %}
    {%- for g in l.facts %}
    {%- set ns.n = ns.n + 1 %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">{{ ns.n }}</span>{{ g.title }}</h2>
      <div class="facts n{{ g['items']|length }}{{ ' ' ~ g.style if g.style }}">
        {%- for it in g['items'] %}
        <div class="fact"><b>{{ it.term }}</b><span>{{ it.text }}</span></div>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
    {{ qa(l, ns.n + 1) }}
    {{- idioms_box(l, ns.n + 2) }}
    {{ new_words(l, ns.n + (3 if l.idioms else 2)) }}
  </div>
  {{ foot(l.title, 'Unit ' ~ l.unit) }}
</div>
{%- elif l.kind == 'podcast' %}
<div class="page stream" data-title="{{ l.title }}" data-part="Unit {{ l.unit }}" data-tighten>
  {{ head('Unit ' ~ l.unit ~ ' · Lesson ' ~ l.lesson) }}
  <div class="flow">
    {{ lesson_start(l) }}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>Before you listen</h2>
      <div class="before">{% for q in l.before %}<p>{{ q }}</p>{% endfor %}</div>
    </div>
    {#- Every line has its time, so the audio can be matched to it later. #}
    <div class="sec convo pod" data-lesson="{{ l.lesson }}">
      <h2><span class="num">2</span>Listen and read <small>{{ l.show }} · Episode {{ l.episode }}</small></h2>
      <div class="scene">{{ l.scene }}</div>
      {%- for time, who, text in l.script %}{% set c = level.cast[who] %}
      <div class="line pline"><span class="t">{{ time }}</span><span class="av {{ c.color }}">{{ c.initial }}</span><span class="who">{{ who|upper }}</span><span>{{ text|mark }}</span></div>
      {%- endfor %}
    </div>
    {{ qa(l, 3) }}
    {{- idioms_box(l, 4) }}
    {{ new_words(l, 5 if l.idioms else 4) }}
  </div>
  {{ foot(l.title, 'Unit ' ~ l.unit) }}
</div>
{%- elif l.kind in ('topic', 'science') %}
{%- set ns = namespace(n=1) %}
<div class="page stream" data-title="{{ l.title }}" data-part="Unit {{ l.unit }}" data-tighten>
  {{ head('Unit ' ~ l.unit ~ ' · Lesson ' ~ l.lesson) }}
  <div class="flow">
    {{ lesson_start(l) }}
    {%- if level.split_boxes %}
    <div class="sec reading topic{{ ' science' if l.kind == 'science' }}" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>Read</h2>
      {%- for para in l.text %}
      <p class="para">{{ para|mark('k') }}</p>
      {%- endfor %}
    </div>
    {%- else %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>Read</h2>
      <div class="story topic">{% for para in l.text %}<p>{{ para|mark('k') }}</p>{% endfor %}</div>
    </div>
    {%- endif %}
    {%- for g in l.facts %}
    {%- set ns.n = ns.n + 1 %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">{{ ns.n }}</span>{{ g.title }}</h2>
      <div class="facts n{{ g['items']|length }}{{ ' steps' if g.steps }}">
        {%- for it in g['items'] %}
        <div class="fact{{ ' mark' if it.mark }}{{ ' icon' if it.icon }}">{% if it.icon %}<i><svg viewBox="0 0 24 24">{{ icons[it.icon]|safe }}</svg></i>{% endif %}<b>{% if g.steps %}<em>{{ loop.index }}</em>{% endif %}{{ it.term }}</b><span>{{ it.text }}</span></div>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
    {%- if l.did_you_know %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <div class="dyk"><b>Did you know?</b><p>{{ l.did_you_know }}</p></div>
    </div>
    {%- endif %}
    {{ qa(l, ns.n + 1) }}
    {{- idioms_box(l, ns.n + 2) }}
    {{ new_words(l, ns.n + (3 if l.idioms else 2)) }}
  </div>
  {{ foot(l.title, 'Unit ' ~ l.unit) }}
</div>
{%- elif l.kind == 'conversation' %}
<div class="page stream" data-title="{{ l.title }}" data-part="Unit {{ l.unit }}" data-tighten>
  {{ head('Unit ' ~ l.unit ~ ' · Lesson ' ~ l.lesson) }}
  <div class="flow">
    {{ lesson_start(l) }}
    {#- The lines sit directly in the section so a long conversation can
        continue on the next page. #}
    <div class="sec convo" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>Read the conversation</h2>
      <div class="scene">{{ l.scene }}</div>
      {%- for who, text in l.conversation %}{% set c = level.cast[who] %}
      <div class="line"><span class="av {{ c.color }}">{{ c.initial }}</span><span class="who">{{ who|upper }}</span><span>{{ text|mark if l.idioms else text }}</span></div>
      {%- endfor %}
    </div>
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">2</span>Useful phrases</h2>
      <div class="phrases">
        {%- for ph in l.phrases %}
        <div class="ph"><h3>{{ ph.title }}</h3><p>{% for line in ph.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% if ph.reply %}<br><span class="reply">— {{ ph.reply }}</span>{% endif %}</p></div>
        {%- endfor %}
      </div>
    </div>
    {{- idioms_box(l, 3) }}
    {{ new_words(l, 4 if l.idioms else 3) }}
  </div>
  {{ foot(l.title, 'Unit ' ~ l.unit) }}
</div>
{%- elif l.kind == 'speaking' %}
<div class="page fit" data-title="{{ l.title }}" data-toc="speaking-{{ l.lesson }}">
  {{ head('Speaking · Lesson ' ~ l.lesson) }}
  <div class="hero">
    <div class="tile icon"><svg viewBox="0 0 24 24">{{ icons[l.icon]|safe }}</svg></div>
    <div>
      <h1>{{ l.title }}</h1>
      <p>{{ l.subtitle }}</p>
      <div class="goal">{% for g in l.goals %}<span>{{ g }}</span>{% endfor %}</div>
    </div>
  </div>
  <div class="flow">
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>Read the conversation</h2>
      <div class="scene">{{ l.scene }}</div>
      <div class="script">
        {%- for who, text in l.conversation %}{% set c = level.cast[who] %}
        <div class="line"><span class="av {{ c.color }}">{{ c.initial }}</span><span class="who">{{ who|upper }}</span><span>{{ text }}</span></div>
        {%- endfor %}
      </div>
    </div>
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">2</span>Useful phrases</h2>
      <div class="phrases">
        {%- for ph in l.phrases %}
        <div class="ph"><h3>{{ ph.title }}</h3><p>{% for line in ph.lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% if ph.reply %}<br><span class="reply">— {{ ph.reply }}</span>{% endif %}</p></div>
        {%- endfor %}
      </div>
    </div>
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">3</span>New words</h2>
      <div class="words">
        {%- for w in l.words %}
        <div class="word"><b>{{ w.word }}</b>{{ w.meaning }}</div>
        {%- endfor %}
      </div>
    </div>
  </div>
  {{ foot(l.title, 'Speaking') }}
</div>
{%- elif l.kind == 'intro' %}
<div class="page stream" data-title="{{ l.title }}" data-part="Phonics">
  {{ head('Phonics · Lesson ' ~ l.lesson) }}
  <div class="flow">
    <div class="lstart" data-lesson="{{ l.lesson }}" data-title="{{ l.title }}" data-toc="phonics-{{ l.lesson }}">
      <div class="hero">
        <div class="tile"><span class="abc-tile">A<em>–</em>Z</span></div>
        <div>
          <h1>{{ l.title }}</h1>
          <p>{{ l.intro }}</p>
          <div class="tags">{% for t in l.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>
        </div>
      </div>
    </div>
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">1</span>26 letters</h2>
      <div class="alpha">
        {%- for c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' %}
        <span class="{{ 'v' if c in 'AEIOU' else 'c' }}">{{ c }}<small>{{ c|lower }}</small></span>
        {%- endfor %}
      </div>
      <div class="alpha-key">
        <span><i class="v"></i><b>Vowels (5):</b> A &nbsp;E &nbsp;I &nbsp;O &nbsp;U</span>
        <span><i class="c"></i><b>Consonants (21):</b> all the other letters</span>
      </div>
      <p class="aside">{{ l.y_note.text }} &nbsp;<b>{{ l.y_note.examples|join(' · ') }}</b></p>
    </div>

    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">2</span>A letter has a name and a sound</h2>
      <p class="lead">We say the <b>name</b> when we spell a word. We say the <b>sound</b> when we read.</p>
      <div class="names">
        {%- for n in l.names %}
        <div class="nrow">
          <span class="ntile">{{ n.letter }}</span>
          <span class="ncell"><small>Name</small><b class="ipa">/{{ n.name }}/</b></span>
          <span class="ncell"><small>Sound</small><b class="ipa">/{{ n.sound }}/</b></span>
          <span class="ncell word"><small>As in</small><b>{{ n.word|word }}</b></span>
        </div>
        {%- endfor %}
      </div>
    </div>

    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">3</span>More sounds than letters</h2>
      <div class="rule plain"><p>English has <b>26 letters</b> but about <b>40 sounds</b>. So one letter can have more than one sound,
        and two letters can work together to make one sound. You will learn them step by step.</p></div>
    </div>

    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">4</span>Sound symbols</h2>
      <p class="lead">A sound symbol shows how we <b>say</b> a sound, not how we write it. We write it between two lines.</p>
      <div class="symbols">
        <div><b class="ipa">/æ/</b><span>the sound of A in c<span class="hl">a</span>t</span></div>
        <div><b class="ipa">/iː/</b><span>the mark <b class="ipa lmark">ː</b> means a long sound</span></div>
      </div>
    </div>

    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">5</span>How to read this book</h2>
      <div class="legend-list">
        <div><span class="lw">c<span class="hl">a</span>t</span><span>Orange letters are the letters we are learning.</span></div>
        <div><span class="lw">mak<span class="sil">e</span></span><span>Grey letters are silent. We do not say them.</span></div>
        <div>{{ badge('always') }}<span>The rule never changes.</span></div>
        <div>{{ badge('usually') }}<span>The rule has a few exceptions.</span></div>
        <div>{{ badge('varies') }}<span>There is no rule. Learn each word.</span></div>
      </div>
    </div>
  </div>
  {{ foot(l.title) }}
</div>
{%- else %}
{%- set vowel = l.letters[0] in 'AEIOU' %}
{%- set multi = l.parts|length > 1 %}
{%- set ns = namespace(n=0) %}
<div class="page stream" data-title="{{ l.title }}" data-part="Phonics">
  {{ head('Phonics · Lesson ' ~ l.lesson) }}
  <div class="flow">
  <div class="lstart" data-lesson="{{ l.lesson }}" data-title="{{ l.title }}" data-toc="phonics-{{ l.lesson }}">
  <div class="abc">
    <span class="lbl">Letters learned</span>
    {%- for c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' %}
    <i class="{{ 'now' if c in l.letters else ('done' if c in p.taught else '') }}">{{ c }}</i>
    {%- endfor %}
  </div>
  <div class="hero">
    <div class="tile{{ ' two' if multi }}"><span>{% for c in l.letters %}{{ c }}<em>{{ c|lower }}</em>{% if not loop.last %} {% endif %}{% endfor %}</span></div>
    <div>
      <h1>{{ l.title }}</h1>
      <p>{{ l.intro }}</p>
      <div class="tags">
        {%- if multi %}<span class="tag">Consonants</span><span class="tag n">{{ l.parts|length }} letters</span>
        {%- else %}{% set n = l.parts[0].sounds|length %}<span class="tag">{{ 'Vowel' if vowel else 'Consonant' }}</span><span class="tag n">{{ n }} sound{{ 's' if n > 1 }}</span>{% endif %}
      </div>
    </div>
  </div>
  </div>
  {%- for part in l.parts %}
    {%- set X = part.letter|upper %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      {%- if multi %}
      <div class="partbar"><span class="ptile">{{ X }}<em>{{ X|lower }}</em></span><b>The Letter {{ X }}</b>{% if part.intro %}<span>{{ part.intro }}</span>{% endif %}</div>
      {%- endif %}
      {%- set ns.n = ns.n + 1 %}
      <h2><span class="num">{{ ns.n }}</span>The sound{{ 's' if part.sounds|length > 1 }} of {{ X }}</h2>
      <div class="sounds n{{ part.sounds|length }}">
        {%- for s in part.sounds %}
        <div class="sound">
          <div class="sym ipa">/{{ s.ipa }}/</div>
          <div class="name">{{ s.name }}</div>
          <ul>{% for ex in s.examples %}<li>{{ ex|word }}</li>{% endfor %}</ul>
        </div>
        {%- endfor %}
      </div>
      {%- for r in part.rules %}
      <div class="rule after">
        <div class="txt">
          <p><b>{{ r.text }}</b>{% if r.detail %}<br>{{ r.detail }}{% endif %}</p>
          {%- if r.examples %}<div class="ex">{% for ex in r.examples %}<span>{{ ex|word }}</span>{% endfor %}</div>{% endif %}
        </div>
        <div class="side">
          {{ badge(r.reliability) }}
          {%- if r.note %}<p>{{ r.note }}{% if r.note_examples %}<br><b class="plainb">{{ r.note_examples|join(' · ') }}</b>{% endif %}</p>{% endif %}
        </div>
      </div>
      {%- endfor %}
    </div>

    <div class="sec" data-lesson="{{ l.lesson }}">
      {%- set ns.n = ns.n + 1 %}
      <h2><span class="num">{{ ns.n }}</span>When is {{ X }} silent?</h2>
      {%- for si in part.silent %}
      {%- if si.none %}
      <div class="rule plain"><p>{{ si.none }}</p></div>
      {%- else %}
      <div class="rule{{ ' after' if not loop.first }}">
        <div class="txt">
          <p><b>{{ si.rule }}</b>{% if si.detail %}<br>{{ si.detail }}{% endif %}</p>
          <div class="ex">{% for ex in si.examples %}<span>{{ ex|word }}</span>{% endfor %}</div>
          {%- if loop.first %}<div class="legend">Grey letter = silent</div>{% endif %}
        </div>
        <div class="side">
          {{ badge(si.reliability) }}
          {%- if si.note %}<p>{{ si.note }}{% if si.note_examples %}<br><b class="plainb">{{ si.note_examples|join(' · ') }}</b>{% endif %}</p>{% endif %}
        </div>
      </div>
      {%- endif %}
      {%- endfor %}
    </div>

    {%- if part.teams %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      {%- set ns.n = ns.n + 1 %}
      <h2><span class="num">{{ ns.n }}</span>{{ X }} with other letters</h2>
      {%- for t in part.teams %}
      <div class="team">
        <div class="pair">{{ t.letters }}</div>
        <div class="rows">
          {%- for s in t.sounds %}
          <div class="r"><span class="sym ipa{{ ' mute' if not s.ipa }}">{{ ('/' ~ s.ipa ~ '/') if s.ipa else 'silent' }}</span><span class="w">{% for ex in s.examples %}<span>{{ ex|word }}</span>{% endfor %}</span></div>
          {%- endfor %}
          {%- if t.note %}<div class="tnote">{{ t.note }}</div>{% endif %}
        </div>
        {{ badge(t.reliability) }}
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  {%- endfor %}
  </div>
  {{ foot(l.title) }}
</div>
{%- if l.chart %}
<div class="page" data-title="{{ l.chart_title }}" data-toc="chart">
  {{ head('Phonics · Lesson ' ~ l.lesson) }}
  <div class="hero chart-hero">
    <div class="tile"><span class="abc-tile ipa">/ə/</span></div>
    <div>
      <h1>{{ l.chart_title }}</h1>
      <p>{{ l.chart_intro }}</p>
    </div>
  </div>
  <div class="flow">
    {%- for g in l.chart %}
    <div class="sec" data-lesson="{{ l.lesson }}">
      <h2><span class="num">{{ loop.index }}</span>{{ g.title }}</h2>
      <div class="chart">
        {%- for it in g['items'] %}
        <div><b class="ipa">/{{ it.ipa }}/</b><span>{{ it.word|word }}</span></div>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
  {{ foot(l.chart_title) }}
</div>
{%- endif %}
{%- endif %}
{%- endfor %}
<script>{{ paginate_js|safe }}</script>
</body>
</html>
