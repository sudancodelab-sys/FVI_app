<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ level.name }}</title>
<style>
@font-face{font-family:Lexend;font-weight:400;src:url('../../../assets/fonts/lexend-latin-400-normal.woff2') format('woff2')}
@font-face{font-family:Lexend;font-weight:500;src:url('../../../assets/fonts/lexend-latin-500-normal.woff2') format('woff2')}
@font-face{font-family:Lexend;font-weight:600;src:url('../../../assets/fonts/lexend-latin-600-normal.woff2') format('woff2')}
@font-face{font-family:Lexend;font-weight:700;src:url('../../../assets/fonts/lexend-latin-700-normal.woff2') format('woff2')}
@font-face{font-family:Lexend;font-weight:800;src:url('../../../assets/fonts/lexend-latin-800-normal.woff2') format('woff2')}
:root{--navy:#262E62;--orange:#E4451A;--ink:#000;--muted:#676E85;--line:#D9DDE7;--pale:#F5F6FA;--teal:#2B9DA5;--teal-pale:#EEF9F9}
@page{size:A4;margin:0}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#e9ebf0;color:var(--ink);font-family:Lexend,Arial,sans-serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.page{width:210mm;height:297mm;position:relative;overflow:hidden;background:#fff;break-after:page;page-break-after:always}
.page:last-child{break-after:auto;page-break-after:auto}
.content-page{padding:9mm 11mm 8mm;display:flex;flex-direction:column;gap:2mm}
.page-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1mm solid var(--orange);padding-bottom:2mm;flex:none}
.brandline{font-size:8pt;font-weight:700;letter-spacing:.45px;color:var(--navy)}
.pageno{font-size:8pt;font-weight:700;color:var(--muted);background:var(--pale);padding:1.3mm 3mm;border-radius:99px;white-space:nowrap}
.footer{margin-top:auto;border-top:.35mm solid var(--line);padding-top:1.5mm;display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:7pt;flex:none}
.footer b{color:var(--navy)}
.star{color:var(--orange);font-size:11pt}
.eyebrow{color:var(--orange);font-size:7pt;font-weight:800;letter-spacing:.9px;text-transform:uppercase}

/* Cover: the full course-cover hierarchy approved for the series. */
.cover{background:#fff}
.cover-art{position:absolute;inset:0;width:100%;height:100%;object-fit:fill}
.cover-head{position:absolute;z-index:2;top:2mm;left:10mm;right:10mm;display:flex;flex-direction:column;align-items:center;text-align:center}
.cover-logo{width:38mm;height:38mm;object-fit:contain}
.cover-institute{margin:0;color:var(--navy);font-size:16pt;font-weight:800;line-height:1.05}
.cover-mark{display:flex;gap:1.2mm;margin-top:1.4mm}
.cover-mark i{display:block;width:28mm;height:1.2mm;background:var(--navy)}
.cover-mark i:nth-child(2){background:var(--orange)}
.cover-course{margin-top:2.4mm;color:var(--navy);font-size:14pt;font-weight:700;line-height:1.1}
.cover-title{margin:2mm 0 0;color:var(--orange);font-size:34pt;font-weight:800;line-height:1;letter-spacing:.2px}
.cover-level{margin-top:1.7mm;padding:1.5mm 7mm;border-radius:99px;background:var(--navy);color:#fff;font-size:11.5pt;font-weight:800;letter-spacing:1px}
.cover-book{margin-top:1.8mm;padding:1.6mm 9mm;border-radius:99px;background:var(--orange);color:#fff;font-size:14pt;font-weight:800}
.cover-tagline{margin-top:1.8mm;color:var(--navy);font-size:9.6pt;font-weight:600;line-height:1.15}
.cover-categories{margin-top:1.3mm;color:var(--orange);font-size:8.7pt;font-weight:700;letter-spacing:.15px}
.cover-student{position:absolute;z-index:3;left:27mm;right:27mm;bottom:13mm;display:flex;align-items:center;gap:3mm;height:10mm;padding:1.5mm 3mm;border:1px solid var(--navy);border-radius:2mm;background:rgba(255,255,255,.96);color:var(--navy);font-size:9.5pt;font-weight:800}
.cover-student i{flex:1;height:4mm;border-bottom:.4mm solid var(--navy)}

/* Common page titles and cards. */
.page-title{margin:0;color:var(--navy);font-size:23pt;font-weight:800;line-height:1.08}
.page-lead{margin:1mm 0 0;color:var(--muted);font-size:9.5pt;line-height:1.45}
.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:3mm;margin:1mm 0 1.2mm}
.section-head b{color:var(--navy);font-size:9pt;font-weight:800}
.section-head span{color:var(--muted);font-size:7.4pt}
.pill{display:inline-flex;align-items:center;justify-content:center;padding:1mm 2.4mm;border-radius:99px;background:#fff;border:1px solid var(--line);color:var(--navy);font-size:6.8pt;font-weight:800;white-space:nowrap}

/* Table of contents. */
.toc-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:2mm;margin-top:1mm}
.toc-section{min-height:15mm;border:1px solid var(--line);border-radius:2.5mm;padding:2mm 2.7mm;display:grid;grid-template-columns:8mm 1fr auto;align-items:center;gap:2mm;background:#fff}
.toc-section .num{width:7mm;height:7mm;border-radius:50%;display:grid;place-items:center;background:var(--navy);color:#fff;font-size:7.5pt;font-weight:800}
.toc-section b{font-size:8pt;color:var(--navy);line-height:1.2}
.toc-section small{font-size:6.8pt;color:var(--muted);white-space:nowrap}
.toc-letters{display:grid;grid-template-columns:repeat(2,1fr);grid-template-rows:repeat(13,10.5mm);grid-auto-flow:column;gap:1.2mm}
.toc-letter{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1.4mm;padding:1.2mm 1.7mm;border:1px solid var(--line);border-radius:2mm;background:#fff;min-width:0}
.toc-letter b{font-size:10pt;color:var(--navy);white-space:nowrap}
.toc-letter span{font-size:7.8pt;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.toc-letter i{font-style:normal;font-size:7.5pt;font-weight:800;color:var(--orange)}

/* Welcome page. */
.welcome-hero{padding:5mm 6mm;border-radius:4mm;background:var(--navy);color:#fff;position:relative;overflow:hidden}
.welcome-hero:after{content:"";position:absolute;right:-8mm;bottom:-15mm;width:42mm;height:42mm;border:3mm solid rgba(255,255,255,.12);border-radius:50%}
.welcome-hero .eyebrow{color:#FFC2AE}
.welcome-hero h1{margin:1.5mm 0 1mm;color:#fff;font-size:25pt;line-height:1.05;font-weight:800}
.welcome-hero p{margin:0;color:#F2F3FA;font-size:11pt;font-weight:600}
.welcome-copy{display:grid;grid-template-columns:1fr 1fr;gap:3mm}
.welcome-copy p{margin:0;padding:3mm 3.5mm;border-left:1.2mm solid var(--orange);border-radius:2.5mm;background:var(--pale);color:#30344B;font-size:9.5pt;line-height:1.45}
.welcome-copy p:last-child{grid-column:1/-1}
.step-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2mm}
.step-card{min-height:36mm;border:1px solid var(--line);border-radius:3mm;padding:2.5mm 2mm;text-align:center;background:#fff}
.step-card .step-num{width:7mm;height:7mm;margin:0 auto 1.3mm;border-radius:50%;display:grid;place-items:center;background:var(--orange);color:#fff;font-size:8pt;font-weight:800}
.step-card b{display:block;color:var(--navy);font-size:9pt}
.step-card small{display:block;margin-top:1mm;color:var(--muted);font-size:6.8pt;line-height:1.25}
.welcome-goals{display:grid;grid-template-columns:1fr 1fr;gap:3mm}
.goal-card{padding:3.2mm 4mm;border-radius:3mm;background:var(--teal-pale);border:1px solid #D5EEEE}
.goal-card h2{margin:0 0 1.5mm;color:var(--navy);font-size:9pt}
.goal-card p{margin:0;color:#344751;font-size:8.7pt;line-height:1.45}
.welcome-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:2mm}
.stat-card{min-height:18mm;display:flex;align-items:center;gap:3mm;padding:2mm 3mm;border:1px solid var(--line);border-radius:3mm;background:#fff}
.stat-card b{color:var(--orange);font-size:22pt;font-weight:800;line-height:1}
.stat-card span{color:var(--navy);font-size:8.5pt;font-weight:700}
.encouragement{padding:3mm 4mm;border-radius:3mm;background:var(--orange);color:#fff;font-size:10pt;font-weight:800;text-align:center}

/* Four-line handwriting guide. */
.guide-note{border-left:1.2mm solid var(--teal);background:var(--teal-pale);border-radius:2.5mm;padding:2mm 3mm;font-size:8.5pt;line-height:1.4;color:#263B46}
.guide-key{display:grid;grid-template-columns:repeat(4,1fr);gap:2mm}
.key-item{display:flex;align-items:center;gap:1.5mm;border:1px solid var(--line);border-radius:2mm;padding:1.5mm 1.8mm;font-size:6.7pt;font-weight:800;color:var(--muted);white-space:nowrap}
.key-mark{width:7mm;height:0;border-top:.4mm solid #8994AB;flex:none}
.key-mark.middle{border-top:.4mm dashed var(--orange)}
.key-mark.base{border-top:.7mm solid var(--navy)}
.key-mark.bottom{border-top:.4mm solid #BBC3D0}
.writing-row{height:31mm;position:relative;border:1px solid #E5E8EF;border-radius:2.5mm;background:#fff;overflow:hidden;flex:none}
.guide-line{position:absolute;left:2mm;right:2mm;height:0}
.guide-line.top{top:2mm;border-top:.35mm solid #8994AB}
.guide-line.middle{top:33.333%;border-top:.35mm dashed var(--orange)}
.guide-line.base{top:66.666%;border-top:.65mm solid var(--navy)}
.guide-line.bottom{bottom:2mm;border-top:.35mm solid #BBC3D0}
.demo-letter{position:absolute;color:#000;font-weight:700;line-height:1;white-space:nowrap}
.demo-letter.cap{left:18mm;bottom:6.5mm;font-size:78pt}
.demo-letter.small{left:80mm;bottom:6.5mm;font-size:52pt}
.demo-letter.tail{left:140mm;bottom:6.5mm;font-size:52pt}
.demo-captions{display:grid;grid-template-columns:repeat(3,1fr);gap:2mm;text-align:center}
.demo-captions span{font-size:7pt;font-weight:800;color:var(--navy)}
.guide-notes{display:grid;grid-template-columns:1fr 1fr;gap:2mm}
.guide-rule{padding:2.3mm 3mm;border:1px solid var(--line);border-radius:2.5mm;background:#fff;color:#34384F;font-size:8pt;line-height:1.4}
.guide-rule b{color:var(--orange)}

/* Approved letter practice layout. */
.lesson-banner{display:flex;justify-content:space-between;align-items:center;border-left:1.4mm solid var(--orange);background:var(--pale);border-radius:2.5mm;padding:2mm 3.5mm;flex:none}
.lesson-banner h1{margin:0;color:var(--navy);font-size:15pt;font-weight:800;line-height:1.1}
.lesson-banner p{margin:.8mm 0 0;color:var(--muted);font-size:8pt;font-weight:600}
.step-tags{display:flex;gap:1.2mm;white-space:nowrap}
.step-tags span{padding:1mm 2mm;border-radius:99px;background:#fff;border:1px solid var(--line);color:var(--navy);font-size:6.5pt;font-weight:800}
.practice-block{display:flex;flex-direction:column;gap:1mm;flex:none}
.practice-head{display:flex;align-items:baseline;gap:2mm;color:var(--navy)}
.practice-head b{font-size:8.7pt;font-weight:800}
.practice-head span{font-size:7.2pt;color:var(--muted)}
.model{position:absolute;left:6mm;bottom:6.5mm;color:#000;line-height:1;font-weight:700;white-space:nowrap}
.model.cap{font-size:78pt;letter-spacing:4mm}
.model.cap.wide{font-size:70pt;letter-spacing:3mm}
.model.small{font-size:52pt;letter-spacing:4mm}
.model.small.wide{font-size:48pt;letter-spacing:3mm}
.model.word{font-size:42pt;letter-spacing:1.2mm}
.model.word.long{font-size:36pt;letter-spacing:1mm}
.write-label{position:absolute;right:4mm;top:2mm;background:#fff;color:var(--muted);font-size:6.4pt;font-weight:800;padding:.4mm 1.2mm;border-radius:1mm;letter-spacing:.5px;text-transform:uppercase}

/* Short conversations. */
.conversation-title{display:flex;align-items:center;gap:4mm;padding:3mm 4mm;border-radius:3.5mm;background:var(--navy);color:#fff}
.conversation-number{width:10mm;height:10mm;border-radius:50%;display:grid;place-items:center;background:var(--orange);font-size:10pt;font-weight:800;flex:none}
.conversation-title h1{margin:0;color:#fff;font-size:20pt;line-height:1.08}
.conversation-title small{display:block;margin-top:1mm;color:#E9EAF4;font-size:8pt;font-weight:600}
.scene{display:flex;gap:2mm;align-items:center;margin:1mm 0;color:var(--muted);font-size:8.5pt;font-style:italic}
.scene:before{content:"";width:1.1mm;align-self:stretch;border-radius:1mm;background:var(--orange)}
.chat{display:flex;flex-direction:column;gap:3mm;padding:1mm 0}
.message{display:flex;align-items:flex-end;gap:2.5mm;max-width:84%}
.message.right{align-self:flex-end;flex-direction:row-reverse}
.avatar{width:10mm;height:10mm;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:8pt;font-weight:800;flex:none}
.avatar.navy{background:var(--navy)}
.avatar.orange{background:var(--orange)}
.bubble{border-radius:4mm;padding:2.5mm 4mm 2.8mm;font-size:12.5pt;line-height:1.4;color:#1D2040}
.message.left .bubble{background:var(--pale);border-bottom-left-radius:1mm}
.message.right .bubble{background:#FDEEE8;border-bottom-right-radius:1mm}
.speaker{display:block;margin-bottom:.6mm;color:var(--muted);font-size:7.5pt;font-weight:700;letter-spacing:.2px}
.conversation-support{display:flex;flex-direction:column;gap:2mm;margin-top:1mm}
.practice-pair{display:grid;grid-template-columns:1fr 1fr;gap:2mm}
.practice-turn{min-height:17mm;padding:2.5mm 3mm;border:1px solid var(--line);border-radius:2.5mm;background:#fff}
.practice-turn b{display:block;color:var(--orange);font-size:7pt;letter-spacing:.5px}
.practice-turn span{display:block;margin-top:1mm;color:var(--navy);font-size:9pt;font-weight:700}
.word-strip{display:flex;align-items:center;gap:3mm;padding:2mm 3mm;border-left:1mm solid var(--teal);border-radius:2.5mm;background:var(--teal-pale)}
.word-strip b{color:var(--teal);font-size:7pt;letter-spacing:.5px;white-space:nowrap}
.word-strip span{color:var(--navy);font-size:8.5pt;font-weight:700}

/* Self-introduction and certificate pages. */
.profile-card{padding:4mm 5mm;border:1px solid var(--line);border-radius:3.5mm;background:#fff}
.profile-line{padding:2.7mm 0;border-bottom:1px dashed #BBC3D0;color:var(--navy);font-size:12pt;font-weight:600}
.profile-line:last-child{border-bottom:0}
.profile-line em{font-style:normal;color:var(--orange)}
.name-practice{display:flex;flex-direction:column;gap:2mm}
.name-practice-group{display:flex;flex-direction:column;gap:1mm}
.name-practice-label{color:var(--navy);font-size:8.5pt;font-weight:800}
.profile-prompt{padding:3mm 4mm;border-radius:3mm;background:var(--orange);color:#fff;text-align:center;font-size:10pt;font-weight:800}
.certificate{height:100%;min-height:250mm;border:1.5mm solid var(--navy);outline:1px solid var(--orange);outline-offset:-4mm;border-radius:4mm;padding:12mm 12mm 10mm;display:flex;flex-direction:column;align-items:center;text-align:center;justify-content:center;gap:5mm;background:linear-gradient(180deg,#fff 0%,#fff 72%,#F5F6FA 100%)}
.certificate .medal{width:18mm;height:18mm;border-radius:50%;display:grid;place-items:center;background:var(--orange);color:#fff;font-size:22pt;font-weight:800}
.certificate h1{margin:0;color:var(--navy);font-size:26pt;line-height:1.1}
.certificate .sub{max-width:145mm;color:var(--muted);font-size:11pt;line-height:1.5}
.certificate .name-field{width:135mm;margin:3mm 0;padding:3mm 4mm;border-bottom:1px solid var(--navy);color:var(--navy);font-size:10pt;font-weight:800;text-align:left}
.certificate .statement{max-width:150mm;color:#34384F;font-size:11pt;line-height:1.55}
.certificate .signatures{width:145mm;display:flex;justify-content:space-between;gap:16mm;margin-top:6mm}
.signature{flex:1;border-top:1px solid var(--navy);padding-top:2mm;color:var(--muted);font-size:8pt}
.certificate .brand{margin-top:3mm;color:var(--orange);font-size:8pt;font-weight:800;letter-spacing:1px}
@media screen{.page{margin:8mm auto;box-shadow:0 3mm 14mm rgba(26,32,60,.18)}}
@media print{html,body{background:#fff}.page{margin:0;box-shadow:none}}
</style>
</head>
<body>
{% macro page_head(label, number) -%}
<header class="page-head">
  <div class="brandline">FUTURE VISION INSTITUTE · KIDS ENGLISH 1</div>
  <div class="pageno">{{ label }}</div>
</header>
{%- endmacro %}
{% macro page_footer(number, label) -%}
<footer class="footer"><span><b>Kids English 1</b> · {{ label }}</span><span>Future Vision Institute</span><span class="star">{{ number }}</span></footer>
{%- endmacro %}

<section class="page cover" data-page="1">
  <img class="cover-art" src="{{ level.cover_art }}" alt="Two children practicing English writing at a classroom desk">
  <div class="cover-head">
    <img class="cover-logo" src="{{ level.logo }}" alt="Future Vision Institute logo">
    <h1 class="cover-institute">{{ level.institute }}</h1>
    <div class="cover-mark"><i></i><i></i><i></i></div>
    <div class="cover-course">{{ level.course }}</div>
    <div class="cover-title">{{ level.title }}</div>
    <div class="cover-level">{{ level.level_label }}</div>
    <div class="cover-book">{{ level.book_type }}</div>
    <div class="cover-tagline">{{ level.tagline }}</div>
    <div class="cover-categories">{{ level.categories | join(' · ') }}</div>
  </div>
  <div class="cover-student"><b>Student Name:</b><i></i></div>
</section>

<section class="page content-page toc-page" data-page="2">
  {{ page_head('CONTENTS', 2) }}
  <div>
    <h1 class="page-title">Inside This Book</h1>
    <p class="page-lead">Start with the guide, then explore every letter.</p>
  </div>
  <div class="toc-summary">
    <div class="toc-section"><span class="num">1</span><b>Welcome and four guide lines</b><small>Pages 3–4</small></div>
    <div class="toc-section"><span class="num">2</span><b>Letters A–Z</b><small>Pages 5–30</small></div>
    <div class="toc-section"><span class="num">3</span><b>Two short conversations</b><small>Pages 31–32</small></div>
    <div class="toc-section"><span class="num">4</span><b>This Is Me! and certificate</b><small>Pages 33–34</small></div>
  </div>
  <div class="section-head"><b>LETTER MAP</b><span>One page for each letter</span></div>
  <div class="toc-letters">
  {% for letter in letters %}
    <div class="toc-letter"><b>{{ letter.upper }} {{ letter.lower }}</b><span>{{ letter.example }}</span><i>{{ '%02d'|format(letter.page_number) }}</i></div>
  {% endfor %}
  </div>
  {{ page_footer(2, 'Contents') }}
</section>

<section class="page content-page welcome-page" data-page="3">
  {{ page_head('WELCOME', 3) }}
  <div class="welcome-hero">
    <div class="eyebrow">YOUR FIRST ENGLISH BOOK</div>
    <h1>{{ content.welcome.title }}</h1>
    <p>{{ content.welcome.lead }}</p>
  </div>
  <div class="welcome-copy">
  {% for paragraph in content.welcome.paragraphs %}
    <p>{{ paragraph }}</p>
  {% endfor %}
  </div>
  <div class="section-head"><b>LEARN IN FOUR STEPS</b><span>Try this on every page.</span></div>
  <div class="step-grid">
  {% for step in content.welcome.steps %}
    <div class="step-card"><span class="step-num">{{ loop.index }}</span><b>{{ step }}</b><small>{% if loop.index == 1 %}Look at the black model.{% elif loop.index == 2 %}Say the letter aloud.{% elif loop.index == 3 %}Follow the guide lines.{% else %}Write it by yourself.{% endif %}</small></div>
  {% endfor %}
  </div>
  <div class="welcome-goals">
    <div class="goal-card"><h2>In this book, you will:</h2><p>Write big and small letters, practice one word for every letter, and speak with a new friend.</p></div>
    <div class="goal-card"><h2>Get ready:</h2><p>Find a pencil, sit comfortably, and take your time. Good writing grows with practice.</p></div>
  </div>
  <div class="welcome-stats">
    <div class="stat-card"><b>26</b><span>English letters</span></div>
    <div class="stat-card"><b>4</b><span>guide lines</span></div>
    <div class="stat-card"><b>2</b><span>conversations</span></div>
  </div>
  <div class="encouragement">{{ content.welcome.encouragement }}</div>
  {{ page_footer(3, 'Welcome') }}
</section>

<section class="page content-page guide-page" data-page="4">
  {{ page_head('FOUR GUIDE LINES', 4) }}
  <div>
    <h1 class="page-title">{{ content.guide.title }}</h1>
    <p class="page-lead">{{ content.guide.lead }}</p>
  </div>
  <div class="guide-key">
    <div class="key-item"><i class="key-mark"></i>{{ content.guide.labels[0].name }}</div>
    <div class="key-item"><i class="key-mark middle"></i>{{ content.guide.labels[1].name }}</div>
    <div class="key-item"><i class="key-mark base"></i>{{ content.guide.labels[2].name }}</div>
    <div class="key-item"><i class="key-mark bottom"></i>{{ content.guide.labels[3].name }}</div>
  </div>
  <div class="section-head"><b>SEE HOW LETTERS SIT</b><span>Black models inside the four guide lines.</span></div>
  {% for example in content.guide.examples %}
  <section class="practice-block">
    <div class="practice-head"><b>{{ example.label }}</b><span>{{ example.caption }}</span></div>
    <div class="writing-row"><i class="guide-line top"></i><i class="guide-line middle"></i><i class="guide-line base"></i><i class="guide-line bottom"></i><span class="model {{ example.style }}">{{ example.sample }}</span><span class="write-label">MODEL</span></div>
  </section>
  {% endfor %}
  <div class="guide-notes">
  {% for note in content.guide.notes %}
    <div class="guide-rule"><b>{{ loop.index }}.</b> {{ note }}</div>
  {% endfor %}
  </div>
  <div class="guide-note"><b>Remember:</b> Keep each letter in its place. Look at the model before you write.</div>
  {{ page_footer(4, 'Writing Guide') }}
</section>

{% for letter in letters %}
<section class="page content-page letter-page" data-page="{{ letter.page_number }}" data-letter="{{ letter.upper }}">
  {{ page_head('LETTER ' ~ letter.number ~ ' / 26', letter.page_number) }}
  <div class="lesson-banner">
    <div><div class="eyebrow">LETTER PRACTICE</div><h1>Look · Copy · Write</h1><p>Use the four guide lines for every letter and word.</p></div>
    <div class="step-tags"><span>CAPITAL</span><span>SMALL</span><span>WORD</span></div>
  </div>
  <div class="guide-note"><b>Letter placement:</b> Most capital letters start at the top line and sit on the base line. Small letters use the middle and base lines. Letter tails can reach the bottom line.</div>
  <div class="guide-key">
    <div class="key-item"><i class="key-mark"></i>TOP LINE</div>
    <div class="key-item"><i class="key-mark middle"></i>MIDDLE LINE</div>
    <div class="key-item"><i class="key-mark base"></i>BASE LINE</div>
    <div class="key-item"><i class="key-mark bottom"></i>BOTTOM LINE</div>
  </div>
  <section class="practice-block">
    <div class="practice-head"><b>CAPITAL LETTER</b><span>Four models to copy.</span></div>
    <div class="writing-row"><i class="guide-line top"></i><i class="guide-line middle"></i><i class="guide-line base"></i><i class="guide-line bottom"></i><span class="model cap{% if letter.wide_cap %} wide{% endif %}">{{ letter.upper_repeat }}</span><span class="write-label">MODEL</span></div>
    <div class="writing-row"><i class="guide-line top"></i><i class="guide-line middle"></i><i class="guide-line base"></i><i class="guide-line bottom"></i><span class="write-label">YOUR TURN</span></div>
  </section>
  <section class="practice-block">
    <div class="practice-head"><b>SMALL LETTER</b><span>Four models to copy.</span></div>
    <div class="writing-row"><i class="guide-line top"></i><i class="guide-line middle"></i><i class="guide-line base"></i><i class="guide-line bottom"></i><span class="model small{% if letter.wide_small %} wide{% endif %}">{{ letter.lower_repeat }}</span><span class="write-label">MODEL</span></div>
    <div class="writing-row"><i class="guide-line top"></i><i class="guide-line middle"></i><i class="guide-line base"></i><i class="guide-line bottom"></i><span class="write-label">YOUR TURN</span></div>
  </section>
  <section class="practice-block">
    <div class="practice-head"><b>WORD EXAMPLE</b><span>Copy the example word on the four lines.</span></div>
    <div class="writing-row"><i class="guide-line top"></i><i class="guide-line middle"></i><i class="guide-line base"></i><i class="guide-line bottom"></i><span class="model word{% if letter.long_word %} long{% endif %}">{{ letter.example }}</span><span class="write-label">MODEL</span></div>
    <div class="writing-row"><i class="guide-line top"></i><i class="guide-line middle"></i><i class="guide-line base"></i><i class="guide-line bottom"></i><span class="write-label">YOUR TURN</span></div>
  </section>
  {{ page_footer(letter.page_number, 'Handwriting') }}
</section>
{% endfor %}

{% for conversation in conversations %}
{% set page_number = 30 + loop.index %}
<section class="page content-page conversation-page" data-page="{{ page_number }}">
  {{ page_head('LET’S TALK ' ~ loop.index, page_number) }}
  <div class="conversation-title"><span class="conversation-number">{{ loop.index }}</span><div><h1>{{ conversation.title }}</h1><small>SHORT CONVERSATION</small></div></div>
  <div class="scene">{{ conversation.scene }}</div>
  <div class="chat">
  {% for line in conversation.lines %}
    <div class="message {{ line.side }}">
      <span class="avatar {{ line.color }}">{{ line.initial }}</span>
      <div class="bubble"><span class="speaker">{{ line.speaker }}</span>{{ line.text }}</div>
    </div>
  {% endfor %}
  </div>
  <div class="conversation-support">
    <div class="practice-pair">
    {% for item in conversation.practice_items %}
      <div class="practice-turn"><b>{{ item.label }}</b><span>{{ item.text }}</span></div>
    {% endfor %}
    </div>
    <div class="word-strip"><b>NEW WORDS</b><span>{{ conversation.words | join(' · ') }}</span></div>
  </div>
  {{ page_footer(page_number, 'Speaking') }}
</section>
{% endfor %}

<section class="page content-page self-page" data-page="33">
  {{ page_head('MY INTRODUCTION', 33) }}
  <div>
    <div class="eyebrow">SPEAKING ABOUT YOU</div>
    <h1 class="page-title">{{ content.self_introduction.title }}</h1>
    <p class="page-lead">{{ content.self_introduction.lead }}</p>
  </div>
  <div class="profile-card">
  {% for line in content.self_introduction.lines %}
    <div class="profile-line">{{ line }}</div>
  {% endfor %}
  </div>
  <div class="name-practice">
  {% for prompt in content.self_introduction.write_prompts %}
    <div class="name-practice-group">
      <div class="name-practice-label">{{ prompt }}</div>
      <div class="writing-row"><i class="guide-line top"></i><i class="guide-line middle"></i><i class="guide-line base"></i><i class="guide-line bottom"></i></div>
    </div>
  {% endfor %}
  </div>
  <div class="profile-prompt">Look up, smile, and say hello!</div>
  {{ page_footer(33, 'Speaking') }}
</section>

<section class="page content-page certificate-page" data-page="34">
  <div class="certificate">
    <div class="eyebrow">FUTURE VISION INSTITUTE</div>
    <div class="medal">★</div>
    <h1>{{ content.certificate.title }}</h1>
    <div class="sub">{{ content.certificate.statement2 }}</div>
    <div class="name-field">{{ content.certificate.name_label }} __________________________________</div>
    <div class="statement">{{ content.certificate.statement }}</div>
    <div class="signatures"><div class="signature">{{ content.certificate.teacher_label }}</div><div class="signature">{{ content.certificate.date_label }}</div></div>
    <div class="brand">KIDS ENGLISH · LEVEL 1</div>
  </div>
  {{ page_footer(34, 'Certificate') }}
</section>
</body>
</html>
